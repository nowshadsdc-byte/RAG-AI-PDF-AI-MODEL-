# Local development only; keep real credentials in .env.
DATABASE_URL=postgres://rag:rag_dev_password@localhost:5432/rag_pdf
POSTGRES_PASSWORD=rag_dev_password

# Answers: DeepSeek via InferX (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://model.inferx.net/endpoints/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017

# Embeddings (768 dims): Gemini
GEMINI_API_KEY=

# Optional upload limit in bytes (empty = no app-level limit; disk space is always checked)
# MAX_UPLOAD_BYTES=2147483648
# Optional absolute folder for uploaded files (default: ./storage)
# STORAGE_DIR=
